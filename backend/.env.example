# Backend Environment Variables Example
# Copy this to .env and update with your actual values

# CORS Origins - Comma separated list of allowed origins
# Use "*" for development or list specific domains for production
# Examples:
# Development: CORS_ORIGINS="*"
# Local Development: CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
# Production: CORS_ORIGINS="https://your-frontend.vercel.app,https://your-domain.com"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Legacy environment variables (keeping for backwards compatibility)
FRONTEND_ORIGIN_URL="your-frontend-domain.com"
BACKEND_ORIGIN_URL="your-backend-domain.com"

# API Configuration
PORT=8000
HOST=0.0.0.0

# Add other backend environment variables here